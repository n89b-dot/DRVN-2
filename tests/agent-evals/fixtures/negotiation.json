    { "name": "buyer's last word clears the minimum: ask the owner", "input": { "scope": "seller", "style": "firm", "listing": { "priceCents": 100000, "shippingCents": 0, "status": "active" }, "limits": { "floorCents": 70000 }, "offer": { "status": "open", "amountCents": 75000, "counterAmountCents": null, "roundCount": 5 }, "rounds": [], "buyerAmounts": [50000, 65000, 75000] }, "expect": { "action": "request_approval", "reason": "final_offer_clears_minimum" } },
    { "name": "buyer agent accepts within its item ceiling", "input": { "scope": "buyer", "style": "balanced", "listing": { "priceCents": 100000, "shippingCents": 5000, "status": "active" }, "limits": { "ceilingCents": 90000, "ceilingBasis": "item" }, "offer": { "status": "countered", "amountCents": 70000, "counterAmountCents": 90000, "roundCount": 2 }, "rounds": [], "buyerAmounts": [70000] }, "expect": { "action": "accept" } },
    { "name": "buyer agent counts shipping on a total ceiling", "input": { "scope": "buyer", "style": "balanced", "listing": { "priceCents": 100000, "shippingCents": 5000, "status": "active" }, "limits": { "ceilingCents": 90000, "ceilingBasis": "total" }, "offer": { "status": "countered", "amountCents": 70000, "counterAmountCents": 90000, "roundCount": 2 }, "rounds": [], "buyerAmounts": [70000] }, "expect": { "action": "counter" } },
    { "name": "buyer agent with no offers left asks before going over", "input": { "scope": "buyer", "style": "flexible", "listing": { "priceCents": 100000, "shippingCents": 0, "status": "active" }, "limits": { "ceilingCents": 80000, "ceilingBasis": "item" }, "offer": { "status": "countered", "amountCents": 80000, "counterAmountCents": 85000, "roundCount": 6 }, "rounds": [], "buyerAmounts": [60000, 70000, 80000] }, "expect": { "action": "request_approval", "reason": "over_ceiling_no_offers_left" } },
