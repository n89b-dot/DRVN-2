 return {from:query,rpc:async()=>({data:[],error:null,count:0}),auth,channel:()=>channel,removeChannel:()=>{},storage:{from:()=>({getPublicUrl:(p:string)=>({data:{publicUrl:p}}),upload:async()=>failure})}};
