# Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Public key — ships in the browser bundle. Newer projects issue
# `sb_publishable_…`; older ones a legacy `anon` JWT. Set whichever you have;
# the publishable key wins if both are present.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Bypasses RLS — never expose it to the browser and never
# prefix it with NEXT_PUBLIC_. Newer projects issue `sb_secret_…`; older ones a
# legacy `service_role` JWT.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin — required for absolute OpenGraph URLs, the sitemap, robots,
# and Stripe Connect onboarding return URLs. Must match the port the app
# actually serves on, or Stripe sends sellers back to a dead port. This repo's
# dev server runs on :3005 (launchd-managed) — a plain `npm run dev` defaults
# to :3000, so adjust this to match whichever you use. Vercel deploys fall
# back to VERCEL_PROJECT_PRODUCTION_URL if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Stripe. Without STRIPE_SECRET_KEY the app runs on the stub provider (no money
# moves, no publish gate) — but production refuses to boot in stub mode unless
# PAYMENTS_ALLOW_STUB_IN_PRODUCTION is set (below). STRIPE_WEBHOOK_SECRET comes
# from the webhook endpoint config (or `stripe listen` locally).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment provider selection (optional). Explicit "stripe" or "stub" wins;
# unset = stripe when STRIPE_SECRET_KEY is present, stub otherwise.
# PAYMENTS_MODE=stripe without a key throws at boot, everywhere.
# PAYMENTS_MODE=stub

# Explicit sandbox override. PAYMENTS_MODE=stub (or a missing Stripe key) is
# refused in production unless this is "true" — a deliberately separate, loud
# switch for non-public sandbox deployments only. Never set on the real site.
# PAYMENTS_ALLOW_STUB_IN_PRODUCTION=true

# Bearer secret for the transfer-worker endpoint (/api/jobs/transfers).
# The scheduler (pg_cron via job_config, or any external cron) must send
# `Authorization: Bearer <CRON_SECRET>`. Unset = the endpoint refuses all runs
# (the admin console's "Run worker now" remains the processing path).
CRON_SECRET=

# Ops alerting (optional). When set, the money worker POSTs a JSON alert here
# for each dispute newly past the 4-day SLA and each recovery case opened.
# The body includes a Slack-compatible `text`, so a Slack incoming webhook
# works as-is. Unset = no alerts (queues remain visible in /admin).
ADMIN_ALERT_WEBHOOK_URL=

# Sentry (optional). Server-side only — the client reports through
# /api/monitoring. Without a DSN all reporting is a silent no-op.
SENTRY_DSN=

# Not used by the application. Only needed for direct psql/CLI access, and best
# kept in a password manager rather than here.
# SUPABASE_DB_PASSWORD=

# Optional self-hosted search engine (brief §B). Unset = the Postgres search
# provider serves everything; setting both enables the Typesense adapter.
# Full rebuild: node scripts/reindex-search.mjs
TYPESENSE_URL=
TYPESENSE_API_KEY=
