# Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Public key — ships in the browser bundle. Newer projects issue
# `sb_publishable_…`; older ones a legacy `anon` JWT. Set whichever you have;
# the publishable key wins if both are present.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Bypasses RLS — never expose it to the browser and never
# prefix it with NEXT_PUBLIC_. Newer projects issue `sb_secret_…`; older ones a
# legacy `service_role` JWT.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin — required for absolute OpenGraph URLs, the sitemap, robots,
# and Stripe Connect onboarding return URLs. Must match the port the app
# actually serves on, or Stripe sends sellers back to a dead port. This repo's
# dev server runs on :3005 (launchd-managed) — a plain `npm run dev` defaults
# to :3000, so adjust this to match whichever you use. Vercel deploys fall
# back to VERCEL_PROJECT_PRODUCTION_URL if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Which hosted deployment this is: "production" or "staging". Required on a
# hosted deploy. Only "production" is indexable by search engines; unset (local
# work, CI) the site tells crawlers to stay away (src/lib/deployment.ts).
DRVN_DEPLOY_ENV=

# Stripe. Without STRIPE_SECRET_KEY the app runs on the stub provider (no money
# moves, no publish gate) — but production refuses to boot in stub mode unless
# PAYMENTS_ALLOW_STUB_IN_PRODUCTION is set (below). STRIPE_WEBHOOK_SECRET comes
# from the webhook endpoint config (or `stripe listen` locally).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Connect endpoint's secret (events on sellers' connected accounts:
# account.updated). Required in live mode.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Payment provider selection (optional). Explicit "stripe" or "stub" wins;
# unset = stripe when STRIPE_SECRET_KEY is present, stub otherwise.
# PAYMENTS_MODE=stripe without a key throws at boot, everywhere.
# PAYMENTS_MODE=stub

# Explicit sandbox override. PAYMENTS_MODE=stub (or a missing Stripe key) is
# refused in production unless this is "true" — a deliberately separate, loud
# switch for non-public sandbox deployments only. Never set on the real site.
# PAYMENTS_ALLOW_STUB_IN_PRODUCTION=true

# Bearer secret for every worker route (/api/jobs/*) and /api/health/workers.
# pg_cron reaches them through job_config.transfer_worker_secret, which must
# hold the same value. Unset = the routes refuse all runs (the admin console's
# "Run worker now" remains the processing path). At least 32 characters;
# REQUIRED in live-money production.
CRON_SECRET=

# Local admin smoke scripts (.page-test.mjs, untracked) sign in as the standing
# console-admin fixture with this password. It has a documented default ONLY on
# the isolated local stack (E2E_TEST_PROJECT_REF=local-drvn-remediation); every
# hosted project must set its own and never commit it. The e2e specs do not use
# it — they create their own disposable admins.
# E2E_CONSOLE_ADMIN_PASSWORD=

# Ops alerting. When set, the money worker POSTs a JSON alert here for each
# dispute newly past the 4-day SLA and each recovery case opened. The body
# includes a Slack-compatible `text`, so a Slack incoming webhook works as-is.
# Optional in dev (unset = alerts recorded as `disabled`, visible in /admin);
# REQUIRED and https: in live-money production (validatePaymentsEnv).
ADMIN_ALERT_WEBHOOK_URL=

# Sentry. Server-side only — the client reports through /api/monitoring.
# Optional in dev (no DSN = reporting is a silent no-op); REQUIRED in
# live-money production as an https: DSN, https://<key>@<host>/<project id>.
SENTRY_DSN=

# Signs the guest-checkout cookies (drvn_guest_orders, drvn_checkout_identity)
# and keys the hashed network identity used for guest abuse limits. At least
# 32 random characters. REQUIRED in live-money production; any production
# build throws without it on first use. Dev falls back to the service key.
# Rotating it invalidates outstanding guest receipts.
GUEST_RECEIPT_SECRET=

# Keys the one-way digest kept in place of a deleted account's email (N16).
# Optional: unset, a key derived from GUEST_RECEIPT_SECRET is used (so
# rotating that secret changes future digests). At least 32 random characters
# when set; set it before launch and don't rotate it.
ACCOUNT_EMAIL_DIGEST_KEY=

# Where signed-out visitors' addresses come from, for checkout, sign-in and
# error-report rate limits. On Vercel (VERCEL=1, set by the platform) leave it
# unset: Vercel's edge overwrites X-Forwarded-For and sets
# X-Vercel-Forwarded-For, so they are trusted automatically. Elsewhere set
# "true" only behind a proxy you have verified overwrites client-supplied
# X-Forwarded-For. "false" turns both off. With no trusted source every
# signed-out visitor shares one rate-limit bucket (live production warns).
# TRUST_PROXY_HEADERS=true

# Not used by the application. Only needed for direct psql/CLI access, and best
# kept in a password manager rather than here.
# SUPABASE_DB_PASSWORD=

# Optional self-hosted search engine (brief §B). Unset = the Postgres search
# provider serves everything; setting both enables the Typesense adapter.
# Full rebuild: node scripts/reindex-search.mjs
TYPESENSE_URL=
TYPESENSE_API_KEY=

# Optional product analytics (brief §AE). Unset = capture() is a no-op; DRVN
# never requires an analytics service. Self-hostable PostHog supported via
# POSTHOG_HOST. Events are the typed taxonomy in src/lib/analytics.ts only —
# no autocapture, no session replay, no sensitive fields.
POSTHOG_KEY=
POSTHOG_HOST=

# Transactional email (src/lib/email/send.ts): order emails (#116) and
# saved-search digests (N78). EMAIL_PROVIDER=resend selects Resend
# (src/lib/email/resend.ts), with RESEND_API_KEY and EMAIL_FROM (an address on
# the verified sending domain, e.g. "DRVN <orders@your-domain>"). Unset = order
# emails are skipped as email_off and digests are recorded; nothing is sent.
# The provider is Neil's to confirm (R-email).
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Listing importer (0047) — "Import an existing listing"
# ---------------------------------------------------------------------------

# Anthropic API key for import extraction (server-only, never NEXT_PUBLIC).
# Unset: non-production runs the deterministic stub extractor; production
# shows "importing temporarily unavailable" instead of degrading silently.
ANTHROPIC_API_KEY=

# Model used for extraction. Configuration, not code — change it here without
# touching the importer. Default: claude-sonnet-5.
# LISTING_IMPORT_MODEL=claude-sonnet-5

# Force the AI mode ("anthropic" | "stub"). stub in production requires
# LISTING_IMPORT_ALLOW_STUB_IN_PRODUCTION=true (sandbox deployments only).
# LISTING_IMPORT_AI_MODE=

# Optional public-page rendering fallback (Playwright Chromium) for pages that
# genuinely need client rendering — notably some Facebook Marketplace pages.
# Requires a deployment where playwright-core + a Chromium binary can run.
# Off = HTTP/forum/paste import still works everywhere.
# LISTING_IMPORT_PUBLIC_BROWSER_ENABLED=true

# TEST ONLY: lets the hardened fetcher reach private-network fixture servers
# (e2e). Ignored in production no matter what.
# LISTING_IMPORT_ALLOW_PRIVATE_HOSTS=true

# ---------------------------------------------------------------------------
# DRVN Shipping (0051-0053) — integrated rates, labels, tracking
# ---------------------------------------------------------------------------

# Rollout flag (§42): the feature does not exist anywhere in the UI until
# this is "true". Seller-arranged shipping always keeps working without it.
FLAG_INTEGRATED_SHIPPING_V1=

# EasyPost API key. Test keys are EZTK…, production EZAK… — nothing in the
# code branches on which; test mode is just the test key. Unset with the flag
# on: dev/e2e run the deterministic stub shipping provider.
# Set on its own (flag off), it still registers seller-entered tracking
# numbers with the EasyPost tracker after dispatch (N110).
EASYPOST_API_KEY=

# HMAC secret for the EasyPost webhook (/api/shipping/easypost). Set it to
# the same value configured on the EasyPost webhook; unset = the endpoint
# refuses everything loudly (500), never processes unverified payloads.
EASYPOST_WEBHOOK_SECRET=

# Force the shipping mode ("easypost" | "stub" | "disabled"). stub in
# production requires SHIPPING_ALLOW_STUB_IN_PRODUCTION=true (sandbox only).
# Unset: key present → easypost; absent → stub in dev, disabled in production.
# SHIPPING_MODE=

# Local seed scripts (.seed-community/.seed-stories/.seed-supercars.mjs):
# the shared test password for the seeded @drvn.test accounts. Dev only.
# DRVN_SEED_PASSWORD=
